{
  "name": "veronaride-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "Verona Ride — Rideshare & Executive Transport Platform. National coverage USA, launching Texas.",
  "workspaces": [
    "backend",
    "mobile",
    "dashboard",
    "shared"
  ],
  "scripts": {
    "backend": "cd backend && npm run dev",
    "mobile": "cd mobile && npx expo start",
    "dashboard": "cd dashboard && npm run dev",
    "db:migrate": "cd database && npm run migrate",
    "db:seed": "cd database && npm run seed",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "promise": "^8.3.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21"
  },
  "overrides": {
    "@types/express": "4.17.21"
  }
}
