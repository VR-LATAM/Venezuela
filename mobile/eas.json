{
  "cli": {
    "version": ">= 7.0.0",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "http://localhost:4000"
      }
    },

    "preview": {
