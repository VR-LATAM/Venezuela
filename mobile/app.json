{
  "expo": {
    "name": "Verona Ride",
    "slug": "veronaride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.veronaride.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Verona Ride needs your location to find nearby drivers and calculate routes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Verona Ride needs your location in the background to update the driver position during your trip.",
        "NSCameraUsageDescription": "Verona Ride needs the camera to take your verification selfie.",
        "NSPhotoLibraryUsageDescription": "Verona Ride needs access to your photos to upload verification documents.",
        "NSMicrophoneUsageDescription": "Required by the camera for identity verification.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A73E8"
      },
      "package": "com.veronaride.app",
      "versionCode": 1,
      "usesCleartextTraffic": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAUmxLQzspdtOUYGUhzo-iNt1FG4mkRwDM"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCertificatePinning",
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Verona Ride needs your location in the background to keep passengers updated during your trip.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A73E8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Verona Ride needs the camera to verify your identity."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Verona Ride needs access to your photos to set your profile picture."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "scheme": "veronaride",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "96eb5e4b-eb6d-4563-9e56-a4b97c3ca6c3"
      },
      "router": {}
    },
    "owner": "edward1234",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/96eb5e4b-eb6d-4563-9e56-a4b97c3ca6c3"
    }
  }
}
