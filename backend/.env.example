# V-RIDE BACKEND — Copia este archivo a .env y rellena con tus valores
# NUNCA subas .env al repositorio

NODE_ENV=development
PORT=4000

# BASE DE DATOS — Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_ID.supabase.co:5432/postgres

# REDIS
REDIS_URL=redis://localhost:6379

# JWT — Genera con: openssl rand -base64 64
JWT_SECRET=GENERA_SECRETO_ALEATORIO_BASE64
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=GENERA_OTRO_SECRETO_ALEATORIO_BASE64
JWT_REFRESH_EXPIRES_IN=30d

# FIREBASE ADMIN SDK — Firebase Console > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@tu-proyecto.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

# GOOGLE MAPS — console.cloud.google.com > Credentials
GOOGLE_MAPS_API_KEY=AIzaSy_TU_KEY_AQUI

# STRIPE — dashboard.stripe.com > Developers > API Keys
STRIPE_SECRET_KEY=sk_test_TU_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_TU_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# ADMIN
ADMIN_PANEL_PASSWORD=CONTRASENA_FUERTE_MINIMO_16_CHARS

# NEGOCIO
PLATFORM_COMMISSION_PERCENT=13
DRIVER_SEARCH_INITIAL_RADIUS_KM=10
DRIVER_SEARCH_MAX_RADIUS_KM=150
DRIVER_SEARCH_STEP_MULTIPLIER=2
DRIVER_ACCEPT_TIMEOUT_SECONDS=30
DRIVER_MAX_CONSECUTIVE_REJECTIONS=3
PASSENGER_FREE_CANCEL_MINUTES=2
CANCELLATION_FEE_USD=3.00
DRIVER_MIN_WITHDRAWAL_USD=10.00
DRIVER_REFERRAL_BONUS_USD=600.00
DRIVER_REFERRAL_RIDES_REQUIRED=50
DRIVER_REFERRED_FIRST_RIDE_BONUS_USD=50.00
GPS_UPDATE_INTERVAL_SECONDS=4

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=30

# EMAIL (opcional)
GMAIL_USER=tu-email@gmail.com
GMAIL_APP_PASSWORD=TU_GMAIL_APP_PASSWORD
