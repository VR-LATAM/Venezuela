# ════════════════════════════════════════════════════════════════
# V-RIDE DASHBOARD ADMIN — Variables de entorno (Next.js)
# Variables NEXT_PUBLIC_ son accesibles en el cliente
# Copia este archivo a .env.local
# ════════════════════════════════════════════════════════════════

# ─────────────────────────────────────
# API BACKEND
# ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─────────────────────────────────────
# GOOGLE MAPS
# API Key con Maps JavaScript API habilitada
# ─────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy_TU_KEY_AQUI

# ─────────────────────────────────────
# NEXT-AUTH
# Genera NEXTAUTH_SECRET: openssl rand -base64 64
# ─────────────────────────────────────
NEXTAUTH_SECRET=GENERAR_SECRETO_64_CARACTERES_ALEATORIOS
NEXTAUTH_URL=http://localhost:3001

# ─────────────────────────────────────
# SOCKET.IO (mismo backend)
# ─────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ─────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
